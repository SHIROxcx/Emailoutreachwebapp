# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Microsoft Entra app registration (see outlook-scheduler-build-plan.md Phase 1)
# For personal Microsoft accounts only, use "consumers".
# For multi-tenant (personal + org accounts), use "common".
MS_TENANT_ID="consumers"
MS_CLIENT_ID=""
MS_CLIENT_SECRET=""

# PostgreSQL (local dev: docker compose up at repo root)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/outreach"

# Redis (local dev: docker compose up at repo root)
REDIS_URL="redis://localhost:6379"

# AES-256-GCM key for encrypting OAuth tokens at rest.
# Must be a base64 string decoding to exactly 32 bytes.
# Generate one with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=""
